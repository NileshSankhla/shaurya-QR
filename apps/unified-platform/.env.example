# Current persistence adapter. Application workflows do not import Supabase.
DATA_PROVIDER=prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true&connection_limit=1
# Direct/session connection used by Prisma migrations. This may equal
# DATABASE_URL when the provider does not require a separate pooler URL.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret
# Existing deployments may keep JWT_SECRET as a temporary compatibility alias.

# Comma-separated origins allowed to call the public registration endpoint.
REGISTRATION_ORIGINS=http://localhost:4173

# Used once by npm run db:seed.
BOOTSTRAP_ADMIN_NAME=Master Admin
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin
